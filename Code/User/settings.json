{
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "editor.cursorBlinking": "solid",
  "editor.smoothScrolling": true,
  "editor.fontFamily": "JetBrains Mono, Symbols Nerd Font Mono",
  "editor.fontLigatures": true,
  "editor.minimap.enabled": false,
  "editor.minimap.renderCharacters": false,
  "editor.suggestSelection": "first",
  "editor.accessibilitySupport": "off",
  "files.autoSave": "afterDelay",
  "workbench.startupEditor": "newUntitledFile",
  "workbench.tree.indent": 10,
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 8,
  "workbench.editorAssociations": {
    "*.png": "imagePreview.previewEditor",
    "*.jpg": "imagePreview.previewEditor"
  },
  "window.titleBarStyle": "custom",
  "window.dialogStyle": "custom",
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,
  "debug.toolBarLocation": "docked",
  "debug.console.closeOnEnd": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "telemetry.telemetryLevel": "off",
  "update.mode": "manual",
  "security.workspace.trust.enabled": false,
  // Elm
  "[elm]": {
    "editor.formatOnSave": true
  },
  // Git
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "git.openRepositoryInParentFolders": "never",
  "git.blame.editorDecoration.enabled": false,
  // GitHub
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  // JSON
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  // LanguageTool
  "languageToolLinter.languageTool.disabledRules": "PLACE_DE_LA_VIRGULE",
  "languageToolLinter.languageTool.ignoredWordsGlobal": [
    "erglace"
  ],
  // Latex
  "latex-workshop.view.pdf.invert": 0.88,
  "latex-workshop.view.pdf.invertMode.grayscale": 0,
  "latex-workshop.latex.autoBuild.run": "never",
  "[latex]": {
    "editor.wordWrap": "on",
    "editor.scrollBeyondLastColumn": 0,
    "editor.stickyScroll.scrollWithEditor": false,
  },
  // Python
  "python.defaultInterpreterPath": "/bin/python",
  // cSpell
  "cSpell.language": "en,fr",
  "cSpell.diagnosticLevel": "Hint",
  "cSpell.userWords": [
    "Erglace",
    "keymap",
    "klayan",
    "minigrep"
  ],
  // XML
  "redhat.telemetry.enabled": false,
}